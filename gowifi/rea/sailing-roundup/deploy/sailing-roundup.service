[Unit]
Description=Publish Sailing Weekend Roundup (landing HTML + PDF)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rea
Group=rea
WorkingDirectory=/opt/rea/work/sailing-roundup
Environment=HOME=/opt/rea
Environment=PATH=/opt/rea/work/sailing-roundup/.venv/bin:/usr/bin:/bin
ExecStart=/bin/bash /opt/rea/work/sailing-roundup/deploy/run-monday.sh /opt/rea/work/sailing-roundup
StandardOutput=append:/opt/rea/work/sailing-roundup/data/publish.log
StandardError=append:/opt/rea/work/sailing-roundup/data/publish.log

[Install]
WantedBy=multi-user.target
