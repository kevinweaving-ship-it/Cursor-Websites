#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_regatta_list_current_window.py ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_regatta_list_current_window.py; python3 -m py_compile /var/www/sailingsa/api/api.py; echo COMPILE:$?; chattr +i /var/www/sailingsa/api/api.py; rm -f /var/tmp/sailingsa_regatta_with_counts.json /var/tmp/sailingsa_regatta_with_counts.json.tmp; systemctl restart sailingsa-api; sleep 3; systemctl is-active sailingsa-api}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
