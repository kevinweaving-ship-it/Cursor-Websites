#!/usr/bin/expect -f
set timeout 70
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_code_overlay_center.py /workspace/sailingsa/deploy/revert_api_wc_flex.py ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/apply_code_overlay_center.py; chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/revert_api_wc_flex.py; chattr +i /var/www/sailingsa/api/api.py; systemctl restart sailingsa-api; sleep 2; systemctl is-active sailingsa-api}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
