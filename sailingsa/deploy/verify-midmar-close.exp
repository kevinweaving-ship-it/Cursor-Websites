#!/usr/bin/expect -f
set timeout 40
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/verify_midmar_close.py ${user}@${server}:/tmp/verify_midmar_close.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/verify_midmar_close.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
