#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_ocf_print.py ${user}@${server}:/tmp/apply_ocf_print.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_ocf_print_${TS}.tar.gz /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_ocf_print_${TS}.tar.gz; chattr -i /var/www/sailingsa/api/api.py 2>/dev/null; python3 /tmp/apply_ocf_print.py; echo APPLY:$?; python3 -m py_compile /var/www/sailingsa/api/api.py; echo COMPILE:$?; rm -f /var/www/sailingsa/api/__pycache__/api.cpython-312.pyc; systemctl restart sailingsa-api; sleep 14; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; python3 - <<'PY'
import re,ssl,time,urllib.request
ctx=ssl._create_unverified_context()
html=''
for n in range(8):
    try:
        req=urllib.request.Request('https://sailingsa.co.za/regatta/2026-09-24-hmyc-dart-18-nationals',headers={'Cache-Control':'no-cache'})
        html=urllib.request.urlopen(req,context=ctx,timeout=20).read().decode('utf-8','replace')
        print('HTTP_OK',n)
        break
    except Exception as e:
        print('WAIT',n,type(e).__name__)
        time.sleep(2)
print('RAW_39_OCF', html.count('>39 OCF<'))
print('SPLIT_OCF', html.count('wc-code">OCF'))
m=re.search(r'.{40}OCF.{40}', html)
print('CTX', m.group(0) if m else 'NO')
PY
echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
