#!/usr/bin/expect -f
# Insert frozen Race 5 mark-1 rounding JSON into vakaros_snapshots on live.
set timeout 180
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]

spawn scp -o StrictHostKeyChecking=no \
  $repo_root/sailingsa/scripts/lipton_vakaros.py \
  $repo_root/sailingsa/scripts/lipton_mark_rounding.py \
  $repo_root/docs/lipton_2026_r5_mark1_rounding.json \
  ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "mkdir -p /tmp/sailingsa-scripts && mv /tmp/lipton_vakaros.py /tmp/lipton_mark_rounding.py /tmp/sailingsa-scripts/ && DB_URL=postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master python3 /tmp/sailingsa-scripts/lipton_mark_rounding.py --save --from-file /tmp/lipton_2026_r5_mark1_rounding.json && psql postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master -c \"SELECT snapshot_id, source, fetched_at, summary->>'kind' AS kind, summary->'accuracy_m'->>'typical_m' AS typical_m, summary->'accuracy_m'->>'conservative_m' AS cons_m, summary->'first'->>'boat' AS first_boat FROM vakaros_snapshots WHERE source='teleapi_mark_rounding' ORDER BY snapshot_id DESC LIMIT 3;\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { puts "ERROR: ssh timeout"; exit 1 }
    eof { }
}
wait
