#!/usr/bin/expect -f
set timeout 40
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]

spawn scp -o StrictHostKeyChecking=no $repo_root/sailingsa/deploy/lipton-keep-playback.sh ${user}@${server}:/root/lipton-keep-playback.sh
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "chmod 700 /root/lipton-keep-playback.sh; grep -q lipton-keep-playback /etc/crontab || echo '* * * * * root /root/lipton-keep-playback.sh' >> /etc/crontab; bash /root/lipton-keep-playback.sh; curl -sS -o /dev/null -w 'page %{http_code} %{size_download}\n' -A SailingSA-devcheck 'https://sailingsa.co.za/regatta/2026-08-29-lipton-challenge-cup?live=1'"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { puts "ERROR: ssh timeout"; exit 1 }
    eof { }
}
wait
