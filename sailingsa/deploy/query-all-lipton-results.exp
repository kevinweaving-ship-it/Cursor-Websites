#!/usr/bin/expect -f
# Query all Lipton results with sail numbers
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "psql postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master -c \"SELECT sail_number, boat_name, club_raw, bow_no, rank, race_scores::text, total_points_raw, nett_points_raw FROM public.results WHERE regatta_id = '2026-08-29-lipton-challenge-cup' ORDER BY rank;\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait
