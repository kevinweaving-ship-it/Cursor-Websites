#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_gold_event_header_all.py /workspace/sailingsa/deploy/apply_gold_event_header_data.py ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_gold_event_header_${TS}.tar.gz /var/www/sailingsa/api/api.py /var/www/sailingsa/sailingsa/backend/cape_classic_fleet_sheet.py; chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_gold_event_header_all.py; python3 /tmp/apply_gold_event_header_data.py; python3 -m py_compile /var/www/sailingsa/api/api.py /var/www/sailingsa/sailingsa/backend/cape_classic_fleet_sheet.py; echo COMPILE:$?; chattr +i /var/www/sailingsa/api/api.py; systemctl restart sailingsa-api; sleep 5; systemctl is-active sailingsa-api}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
