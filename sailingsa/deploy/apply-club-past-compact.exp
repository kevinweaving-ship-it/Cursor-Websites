#!/usr/bin/expect -f
set timeout 120
set password "TimAdd#072082"
set server "102.218.215.253"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_club_past_compact.py root@${server}:/tmp/apply_club_past_compact.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no root@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_club_past_compact_${TS}.tar.gz /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_club_past_compact_${TS}.tar.gz; chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_club_past_compact.py; python3 -m py_compile /var/www/sailingsa/api/api.py; echo COMPILE:$?; if python3 -m py_compile /var/www/sailingsa/api/api.py; then chattr +i /var/www/sailingsa/api/api.py; systemctl restart sailingsa-api; sleep 7; systemctl is-active sailingsa-api; else echo COMPILE_FAIL; fi}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
