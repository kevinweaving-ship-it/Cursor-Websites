#!/usr/bin/expect -f
# Query J-Walker race scores from Lipton 2026
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "psql postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master -c \"SELECT result_id, helm_name, boat_name, bow_no, race_scores::text, total_points_raw, nett_points_raw FROM public.results WHERE regatta_id = '2026-08-29-lipton-challenge-cup' AND bow_no = '8';\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait
