#!/usr/bin/expect -f
set timeout 150
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {mkdir -p /tmp/hmyc-cam-js}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/js/club-live-media.js /workspace/sailingsa/js/midmar-live-media.js /workspace/sailingsa/js/mm-lipton-reels-card.js /workspace/sailingsa/deploy/apply_hmyc_cam_hide.py /workspace/sailingsa/deploy/apply_hmyc_snapshot_valid.py ${user}@${server}:/tmp/hmyc-cam-js/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_hmyc_cam_${TS}.tar.gz /var/www/sailingsa/js/club-live-media.js /var/www/sailingsa/js/midmar-live-media.js /var/www/sailingsa/js/mm-lipton-reels-card.js /var/www/sailingsa/api/weather_agromet.py /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_hmyc_cam_${TS}.tar.gz; mv /tmp/hmyc-cam-js/apply_hmyc_cam_hide.py /tmp/; mv /tmp/hmyc-cam-js/apply_hmyc_snapshot_valid.py /tmp/; chattr -i /var/www/sailingsa/api/api.py /var/www/sailingsa/api/weather_agromet.py 2>/dev/null; python3 /tmp/apply_hmyc_snapshot_valid.py; echo WX:$?; python3 /tmp/apply_hmyc_cam_hide.py; echo APPLY:$?; python3 -m py_compile /var/www/sailingsa/api/weather_agromet.py; echo WX_COMPILE:$?; rm -f /var/www/sailingsa/api/__pycache__/api.cpython-312.pyc; systemctl restart sailingsa-api; sleep 8; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; python3 - <<'PY'
import json,urllib.request
print("CAM", json.loads(urllib.request.urlopen("http://127.0.0.1:8000/api/club-cam/hmyc", timeout=20).read().decode()))
for path in ("/club/hmyc", "/regatta/2026-09-24-hmyc-dart-18-nationals", "/regatta/2026-09-19-hmyc-midmar-cup"):
    req = urllib.request.Request("http://127.0.0.1:8000"+path, headers={"Host":"sailingsa.co.za"})
    html = urllib.request.urlopen(req, timeout=20).read().decode("utf-8","replace")
    print("HTML", path, "clubwx19", html.count("clubwx19"), "clubwx21", html.count("clubwx21"), "clubwx22", html.count("clubwx22"), "midmarwx57", html.count("midmarwx57"), "midmarwx578", html.count("midmarwx578"), "midmarwx58", html.count("midmarwx58"))
    for n in ("club-live-media.js", "midmar-live-media.js"):
        i = html.find(n)
        if i>=0: print("  ", html[i:i+60])
PY
echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
