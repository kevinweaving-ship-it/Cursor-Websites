#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {mkdir -p /tmp/hmyc-cam-js}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/js/club-live-media.js /workspace/sailingsa/js/midmar-live-media.js /workspace/sailingsa/js/mm-lipton-reels-card.js /workspace/sailingsa/deploy/apply_hmyc_cam_hide.py /workspace/sailingsa/deploy/apply_hmyc_snapshot_valid.py ${user}@${server}:/tmp/hmyc-cam-js/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_hmyc_cam_${TS}.tar.gz /var/www/sailingsa/js/club-live-media.js /var/www/sailingsa/js/midmar-live-media.js /var/www/sailingsa/js/mm-lipton-reels-card.js /var/www/sailingsa/api/weather_agromet.py /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_hmyc_cam_${TS}.tar.gz; mv /tmp/hmyc-cam-js/apply_hmyc_cam_hide.py /tmp/; mv /tmp/hmyc-cam-js/apply_hmyc_snapshot_valid.py /tmp/; chattr -i /var/www/sailingsa/api/api.py /var/www/sailingsa/api/weather_agromet.py 2>/dev/null; python3 /tmp/apply_hmyc_snapshot_valid.py; echo WX:$?; python3 /tmp/apply_hmyc_cam_hide.py; echo APPLY:$?; python3 -m py_compile /var/www/sailingsa/api/weather_agromet.py; echo WX_COMPILE:$?; systemctl restart sailingsa-api; sleep 6; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; python3 - <<'PY'
import json,urllib.request
print(json.loads(urllib.request.urlopen("http://127.0.0.1:8000/api/club-cam/hmyc", timeout=20).read().decode()))
PY
echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
