#!/usr/bin/expect -f
# Fast live GPS/tail deploy. No packed trail JSON, no full api.py replace.
set timeout 120
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]

spawn bash -c "scp -o StrictHostKeyChecking=no \
  $repo_root/sailingsa/frontend/lipton-dev.html \
  $repo_root/sailingsa/frontend/js/lipton-dev-playback.js \
  $repo_root/css/lipton-dev.css \
  $repo_root/sailingsa/scripts/lipton_vakaros.py \
  $repo_root/sailingsa/scripts/lipton_dev_live.py \
  $repo_root/sailingsa/deploy/patch_lipton_dev_live.py \
  ${user}@${server}:/tmp/"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "mkdir -p /var/www/sailingsa/sailingsa/scripts /var/www/sailingsa/js /var/www/sailingsa/css && cp /tmp/lipton-dev.html /var/www/sailingsa/lipton-dev.html && cp /tmp/lipton-dev-playback.js /var/www/sailingsa/js/lipton-dev-playback.js && cp /tmp/lipton-dev.css /var/www/sailingsa/css/lipton-dev.css && cp /tmp/lipton_vakaros.py /tmp/lipton_dev_live.py /var/www/sailingsa/sailingsa/scripts/ && python3 /tmp/patch_lipton_dev_live.py && echo '{\"race_number\":6,\"stage\":\"starting\",\"gun_ts_ms\":1787918701000,\"gun_sast\":\"2026-08-28T14:05:01+02:00\"}' > /tmp/lipton_dev_live_state.json && systemctl restart sailingsa-api && sleep 4 && systemctl is-active sailingsa-api && curl -sS -o /dev/null -w 'page %{http_code}\\n' -A 'SailingSA-devcheck' https://sailingsa.co.za/regatta/2026-08-29-lipton-challenge-cup-dev && curl -sS https://sailingsa.co.za/api/lipton-dev/live | python3 -c \"import json,sys; d=json.load(sys.stdin); b=d.get('boats') or {}; print('ok',d.get('ok'),'err',d.get('error'),'n',len(b),'race',d.get('race_number'),'gun',d.get('gun_sast')); print('trail', max((len((b[s] or {}).get('trail') or []) for s in b), default=0) if b else 0)\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { puts "ERROR: ssh timeout"; exit 1 }
    eof { }
}
wait
