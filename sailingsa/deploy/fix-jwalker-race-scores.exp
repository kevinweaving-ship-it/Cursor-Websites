#!/usr/bin/expect -f
# Fix J-Walker race scores R3 and R10
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "psql postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master -c \"
UPDATE public.results 
SET race_scores = jsonb_set(
    jsonb_set(race_scores::jsonb, '{R3}', '\\\"10.0\\\"'),
    '{R10}', '\\\"6.0\\\"'
)
WHERE regatta_id = '2026-08-29-lipton-challenge-cup' 
  AND bow_no = '8'
  AND sail_number = '173';
\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait
