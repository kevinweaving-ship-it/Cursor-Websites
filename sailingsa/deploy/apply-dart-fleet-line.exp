#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_dart_fleet_line.py ${user}@${server}:/tmp/apply_dart_fleet_line.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_dart_fleet_line_${TS}.tar.gz /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_dart_fleet_line_${TS}.tar.gz; chattr -i /var/www/sailingsa/api/api.py 2>/dev/null; python3 /tmp/apply_dart_fleet_line.py; echo APPLY:$?; python3 -m py_compile /var/www/sailingsa/api/api.py; echo COMPILE:$?; rm -f /var/www/sailingsa/api/__pycache__/api.cpython-312.pyc; systemctl restart sailingsa-api; sleep 12; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; python3 - <<'PY'
import re,ssl,urllib.request
ctx=ssl._create_unverified_context()
req=urllib.request.Request('https://sailingsa.co.za/regatta/2026-09-24-hmyc-dart-18-nationals',headers={'Cache-Control':'no-cache'})
html=urllib.request.urlopen(req,context=ctx,timeout=30).read().decode('utf-8','replace')
print('DH_FLEET', html.count('DH Fleet'))
m=re.search(r'class="fleet-title-with-logo">(.{0,280})', html)
print('TITLE', m.group(0) if m else 'NO')
PY
echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
