#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_event_header_status_gold.py ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/apply_event_header_status_gold.py; python3 -m py_compile /var/www/sailingsa/sailingsa/backend/cape_classic_fleet_sheet.py; echo COMPILE:$?; systemctl restart sailingsa-api; sleep 3; systemctl is-active sailingsa-api}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
