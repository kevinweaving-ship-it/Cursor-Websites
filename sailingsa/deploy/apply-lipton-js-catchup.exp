#!/usr/bin/expect -f
# JS + catchup only. No api.py replace, no API restart, no Race 6 state.
set timeout 300
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]

spawn bash -c "scp -o StrictHostKeyChecking=no \
  $repo_root/sailingsa/frontend/lipton-dev.html \
  $repo_root/sailingsa/frontend/js/lipton-dev-playback.js \
  $repo_root/sailingsa/scripts/lipton_dev_catchup.py \
  $repo_root/sailingsa/scripts/lipton_dev_live.py \
  $repo_root/sailingsa/deploy/patch_lipton_js_nostore.py \
  ${user}@${server}:/tmp/"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "cp /tmp/lipton-dev.html /var/www/sailingsa/lipton-dev.html && cp /tmp/lipton-dev-playback.js /var/www/sailingsa/js/lipton-dev-playback.js && cp /tmp/lipton-dev-playback.js /var/www/sailingsa/js/lipton-dev-playback-dk.js && cp /tmp/lipton-dev-playback.js /var/www/sailingsa/frontend/js/lipton-dev-playback.js && cp /tmp/lipton_dev_catchup.py /tmp/lipton_dev_live.py /var/www/sailingsa/sailingsa/scripts/ && python3 /tmp/lipton_dev_catchup.py && python3 /tmp/patch_lipton_js_nostore.py && nginx -t && nginx -s reload && curl -sS -A SailingSA-devcheck https://sailingsa.co.za/regatta/2026-08-29-lipton-challenge-cup | python3 -c 'import sys; t=sys.stdin.read(); print(\"dkjs\", \"lipton-dev-playback-dk.js\" in t); print(\"old\", \"WEATHER\" in t or \"Live cam\" in t)'"

expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { puts "ERROR: ssh timeout"; exit 1 }
    eof { }
}
wait
