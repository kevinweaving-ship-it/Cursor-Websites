#!/usr/bin/expect -f
set timeout 300
set password "TimAdd#072082"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]
set js "$repo_root/sailingsa/frontend/js"

spawn scp -o StrictHostKeyChecking=no \
  $repo_root/sailingsa/frontend/lipton-dev.html \
  $repo_root/sailingsa/frontend/css/lipton-dev.css \
  $repo_root/sailingsa/frontend/js/lipton-dev-playback-du.js \
  $js/lipton-dev-races.json \
  $js/lipton-dev-replay-r6.json \
  $js/lipton-dev-replay-r8.json \
  $js/lipton-dev-replay-r9.json \
  $js/lipton-dev-replay-r10.json \
  $js/lipton-dev-trail-r6.json \
  $js/lipton-dev-trail-r8.json \
  $js/lipton-dev-trail-r9.json \
  $js/lipton-dev-trail-r10.json \
  $repo_root/sailingsa/deploy/apply-lipton-dev-r1r10.sh \
  root@102.218.215.253:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

spawn ssh -o StrictHostKeyChecking=no root@102.218.215.253 bash /tmp/apply-lipton-dev-r1r10.sh
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { puts "ERROR: ssh timeout"; exit 1 }
    eof { }
}
wait
