#!/usr/bin/expect -f
set timeout 120
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/rebuild_midmar_pdf.py ${user}@${server}:/tmp/rebuild_midmar_pdf.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/rebuild_midmar_pdf.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
