#!/usr/bin/expect -f
# Lipton: keep Super-admin RACING (no poll demote) and enable Race mode.
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]

spawn scp -o StrictHostKeyChecking=no $script_dir/patch_lipton_racing_sticks.py ${user}@${server}:/tmp/patch_lipton_racing_sticks.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "python3 /tmp/patch_lipton_racing_sticks.py all && systemctl restart sailingsa-api && sleep 2 && systemctl is-active sailingsa-api && echo APPLIED_OK"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    "APPLIED_OK" { puts "RACING sticks applied" }
    timeout { puts "ERROR: ssh timeout"; exit 1 }
    eof { }
}
wait
