#!/usr/bin/expect -f
set timeout 45
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_midmar_smoke_oakum.py ${user}@${server}:/tmp/apply_midmar_smoke_oakum.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/apply_midmar_smoke_oakum.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
