#!/usr/bin/expect -f
set timeout 180
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {mkdir -p /tmp/hmyc-cam-js}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/js/midmar-live-media.js /workspace/sailingsa/deploy/apply_dart_song.py ${user}@${server}:/tmp/hmyc-cam-js/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_dart_song_${TS}.tar.gz /var/www/sailingsa/js/midmar-live-media.js /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_dart_song_${TS}.tar.gz; mv /tmp/hmyc-cam-js/apply_dart_song.py /tmp/; chattr -i /var/www/sailingsa/api/api.py 2>/dev/null; python3 /tmp/apply_dart_song.py; echo APPLY:$?; rm -f /var/www/sailingsa/api/__pycache__/api.cpython-312.pyc; systemctl restart sailingsa-api; sleep 10; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; python3 - <<'PY'
from pathlib import Path
import urllib.request
js=Path("/var/www/sailingsa/js/midmar-live-media.js").read_text()
print("JS_VER", "midmarwx59" in js, "TOGGLE", "toggleFromBrand" in js, "FAST", "dart-nats-theme-fast" in js)
print("MP3", Path("/var/www/sailingsa/assets/dart-nats-theme-fast.mp3").stat().st_size)
req=urllib.request.Request("http://127.0.0.1:8000/regatta/2026-09-24-hmyc-dart-18-nationals", headers={"Host":"sailingsa.co.za"})
try:
    html=urllib.request.urlopen(req, timeout=25).read().decode("utf-8","replace")
    print("HTML midmarwx59", html.count("midmarwx59"), "midmarwx58", html.count("midmarwx58"))
    i=html.find("midmar-live-media.js")
    print("SRC", html[i:i+70] if i>=0 else "NONE")
except Exception as e:
    print("HTML_ERR", e)
PY
echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
