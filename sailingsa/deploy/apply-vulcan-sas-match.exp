#!/usr/bin/expect -f
set timeout 60
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/match_vulcan_sailors_sas.py ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/match_vulcan_sailors_sas.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
