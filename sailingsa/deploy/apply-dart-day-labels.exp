#!/usr/bin/expect -f
set timeout 60
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {mkdir -p /tmp/hmyc-cam-js}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/js/mm-lipton-reels-card.js /workspace/sailingsa/js/midmar-live-media.js /workspace/sailingsa/deploy/apply_dart_day_labels.py ${user}@${server}:/tmp/hmyc-cam-js/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_dart_days_${TS}.tar.gz /var/www/sailingsa/js/mm-lipton-reels-card.js /var/www/sailingsa/js/midmar-live-media.js; echo BACKUP:/root/backup_dart_days_${TS}.tar.gz; python3 /tmp/hmyc-cam-js/apply_dart_day_labels.py; python3 - <<'PY'
from pathlib import Path
t=Path("/var/www/sailingsa/js/mm-lipton-reels-card.js").read_text()
print("HAS", "dartDayNumberFromKey" in t, t.count(" - Day "))
print("DART25", "hmycdart25" in Path("/var/www/sailingsa/js/midmar-live-media.js").read_text())
PY
echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
