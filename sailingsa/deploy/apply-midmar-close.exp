#!/usr/bin/expect -f
set timeout 180
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_midmar_close.py ${user}@${server}:/tmp/apply_midmar_close.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_midmar_close_${TS}.tar.gz /var/www/sailingsa/sailingsa/backend/cape_classic_fleet_sheet.py /opt/arial-whatsapp-poc/event_whatsapp_ingest.py; echo BACKUP:/root/backup_midmar_close_${TS}.tar.gz; python3 /tmp/apply_midmar_close.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
