# Copy to /opt/hycnvr/.env on live. Do not commit the live file.
# Hik-Connect login is the same account as Voelklip hikpoc.
HIK_ACCOUNT=
HIK_PASSWORD=
HIK_HOST=api.hik-connect.com
# HYC NVR device password / media decrypt key (not the Hik-Connect cloud password).
HIK_MEDIA_KEY=
HYC_NVR_PASSWORD=
HYC_NVR_SERIAL=D23413606
HYC_NVR_CHANNEL=5
HIK_PS_CLEAR=0
