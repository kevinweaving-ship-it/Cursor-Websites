#!/usr/bin/expect -f
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "tail -50 /var/log/nginx/access.log | grep -i lipton"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
