#!/usr/bin/expect -f
# Hide Lipton live-race board when racing is done / no current race.
# From project root: expect sailingsa/deploy/apply-lipton-no-live-race.exp
set timeout 120
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn bash -c "scp -o StrictHostKeyChecking=no sailingsa/deploy/patch_lipton_no_live_race.py ${user}@${server}:/tmp/patch_lipton_no_live_race.py && ssh -o StrictHostKeyChecking=no ${user}@${server} \"python3 /tmp/patch_lipton_no_live_race.py && systemctl restart sailingsa-api && sleep 2 && systemctl is-active sailingsa-api\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    -re "password" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait
