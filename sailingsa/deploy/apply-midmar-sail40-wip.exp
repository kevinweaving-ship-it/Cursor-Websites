#!/usr/bin/expect -f
set timeout 180
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_midmar_sail40_wip.py ${user}@${server}:/tmp/apply_midmar_sail40_wip.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_midmar_sail40_wip.py; python3 -m py_compile /var/www/sailingsa/api/api.py; echo API_COMPILE:$?; systemctl restart sailingsa-api; sleep 5; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
