#!/usr/bin/expect -f
# Load our 3x Lipton GPS sqlite copy into live sailors_master.lipton_telemetry.
set timeout 900
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]

spawn scp -o StrictHostKeyChecking=no \
  /tmp/lipton_telemetry.sqlite.gz \
  $repo_root/sailingsa/scripts/lipton_dev_load_telemetry_pg.py \
  ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: scp timeout"; exit 1 }
}
wait

set timeout 1800
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "gunzip -f /tmp/lipton_telemetry.sqlite.gz && PY=python3 && /var/www/sailingsa/venv/bin/python -c 'import psycopg2' 2>/dev/null && PY=/var/www/sailingsa/venv/bin/python; LIPTON_SQLITE=/tmp/lipton_telemetry.sqlite DB_URL=postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master \$PY /tmp/lipton_dev_load_telemetry_pg.py && psql postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master -c \"SELECT race_number, COUNT(*) FROM public.lipton_telemetry GROUP BY 1 ORDER BY 1;\""
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { puts "ERROR: ssh load timeout"; exit 1 }
    eof { }
}
wait
