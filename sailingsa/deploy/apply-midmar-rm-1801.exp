#!/usr/bin/expect -f
set timeout 120
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_midmar_rm_1801.py ${user}@${server}:/tmp/apply_midmar_rm_1801.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_midmar_rm1801_${TS}.tar.gz /var/www/sailingsa/sailingsa/backend/mm_event_clips.py /opt/arial-whatsapp-poc/event_whatsapp_ingest.py /var/www/sailingsa/assets/mm-clips/2026-09-19-hmyc-midmar-cup/clips.json; echo BACKUP:/root/backup_midmar_rm1801_${TS}.tar.gz; python3 /tmp/apply_midmar_rm_1801.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
