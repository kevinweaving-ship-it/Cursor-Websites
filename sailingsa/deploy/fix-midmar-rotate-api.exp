#!/usr/bin/expect -f
set timeout 60
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/fix_midmar_rotate_api.py ${user}@${server}:/tmp/fix_midmar_rotate_api.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/fix_midmar_rotate_api.py; python3 -m py_compile /var/www/sailingsa/api/api.py; echo API_COMPILE:$?; python3 -c "from sailingsa.backend.mm_event_clips import set_clip_rotation; print('FN_OK')"; chattr +i /var/www/sailingsa/api/api.py; systemctl restart sailingsa-api; sleep 6; systemctl is-active sailingsa-api}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
