#!/usr/bin/expect -f
set timeout 1800
set password "TimAdd#072082"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_club_cache_ver.py /workspace/sailingsa/deploy/apply_club_gold_warm.py root@102.218.215.253:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no root@102.218.215.253 {set -e; chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_club_cache_ver.py; python3 -m py_compile /var/www/sailingsa/api/api.py; echo COMPILE:$?; chattr +i /var/www/sailingsa/api/api.py; python3 /tmp/apply_club_gold_warm.py wipe; echo STOP; systemctl stop sailingsa-api; python3 /tmp/apply_club_gold_warm.py wipe; systemctl start sailingsa-api; sleep 6; systemctl is-active sailingsa-api; echo WARM; python3 /tmp/apply_club_gold_warm.py warm; echo EXIT:$?}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
