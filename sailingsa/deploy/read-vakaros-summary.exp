#!/usr/bin/expect -f
# Read lipton vakaros summary
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "cat /root/lipton-vakaros-archive/lipton_vakaros_summary.json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps(d, indent=2))' | head -300"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait
