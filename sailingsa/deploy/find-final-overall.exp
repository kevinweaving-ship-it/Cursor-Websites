#!/usr/bin/expect -f
# Find final overall results
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "find /root /var/www/sailingsa /tmp -iname '*final*overall*' -o -iname '*overall*final*' -o -iname '*lipton*final*' -o -iname '*lipton*10*' 2>/dev/null | head -20; ls -la /root/*.pdf /tmp/*.pdf 2>/dev/null | head -10"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait
