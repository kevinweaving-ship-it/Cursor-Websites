#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_phone_403_nginx.py /workspace/sailingsa/deploy/apply_phone_403_api.py ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_phone_403_${TS}.tar.gz /etc/nginx/snippets/sailingsa-swarm-deny.conf /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_phone_403_${TS}.tar.gz; python3 /tmp/apply_phone_403_nginx.py; echo NGINX_APPLY:$?; nginx -t && systemctl reload nginx; echo NGINX_RELOAD:$?; chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_phone_403_api.py; echo API_APPLY:$?; systemctl restart sailingsa-api; sleep 6; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
