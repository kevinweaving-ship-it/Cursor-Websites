#!/usr/bin/expect -f
set timeout 30
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "sed -n '65295,65302p' /var/www/sailingsa/api/api.py; echo '---'; sed -n '65250,65295p' /var/www/sailingsa/api/api.py"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
