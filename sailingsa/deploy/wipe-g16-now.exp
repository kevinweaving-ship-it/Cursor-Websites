#!/usr/bin/expect -f
set timeout 60
set password "TimAdd#072082"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]
spawn scp -o StrictHostKeyChecking=no $repo_root/sailingsa/deploy/wipe-g16-now.sh $repo_root/sailingsa/deploy/force_lipton_nginx_alias.py root@102.218.215.253:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof {}
    timeout { exit 1 }
}
wait
spawn ssh -o StrictHostKeyChecking=no root@102.218.215.253 "cp /tmp/force_lipton_nginx_alias.py /root/force_lipton_nginx_alias.py; bash /tmp/wipe-g16-now.sh"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { exit 1 }
    eof {}
}
wait
