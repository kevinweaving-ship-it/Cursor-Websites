#!/usr/bin/expect -f
set timeout 45
set password "TimAdd#072082"
set script_dir [file dirname [info script]]
set repo_root [file normalize "$script_dir/../.."]
spawn scp -o StrictHostKeyChecking=no $repo_root/sailingsa/deploy/diag-old-page-back.sh root@102.218.215.253:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof {}
    timeout { exit 1 }
}
wait
spawn ssh -o StrictHostKeyChecking=no root@102.218.215.253 "bash /tmp/diag-old-page-back.sh"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    timeout { exit 1 }
    eof {}
}
wait
