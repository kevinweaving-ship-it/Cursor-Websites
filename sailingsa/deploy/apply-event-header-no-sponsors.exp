#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_event_header_no_sponsors.py ${user}@${server}:/tmp/apply_event_header_no_sponsors.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_event_header_no_sponsors_${TS}.tar.gz /var/www/sailingsa/deploy/sponsor_profiles.py /var/www/sailingsa/api/sponsor_profiles.py; echo BACKUP:/root/backup_event_header_no_sponsors_${TS}.tar.gz; python3 /tmp/apply_event_header_no_sponsors.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
