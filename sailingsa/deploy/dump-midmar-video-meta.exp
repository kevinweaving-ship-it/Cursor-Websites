#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/dump_midmar_video_meta.py ${user}@${server}:/tmp/dump_midmar_video_meta.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {python3 /tmp/dump_midmar_video_meta.py}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
