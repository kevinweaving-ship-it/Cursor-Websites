#!/usr/bin/expect -f
# Apply patch: Lipton Challenge Cup 2026 sailed line fix (Sailed: 3, Discards: 0, To count: 3). Run from project root.
set timeout 60
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"
set script_dir [file dirname [info script]]
set project_root [file normalize "$script_dir/../.."]
set sql_path "$project_root/sailingsa/deploy/patch_lipton_2026_sailed_line.sql"

if {![file exists $sql_path]} {
    puts "ERROR: patch_lipton_2026_sailed_line.sql not found."
    exit 1
}

puts "=== Uploading patch_lipton_2026_sailed_line.sql to live ==="
spawn scp -o StrictHostKeyChecking=no $sql_path ${user}@${server}:/tmp/
expect {
    -re "assword" { send "$password\r"; exp_continue }
    "100%" { expect eof }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait

puts "=== Applying patch on live DB ==="
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "psql postgresql://sailors_user:SailSA_Pg_Beta2026@localhost:5432/sailors_master -f /tmp/patch_lipton_2026_sailed_line.sql 2>&1"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    "UPDATE" { }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait

puts "=== Restart API ==="
spawn ssh -o StrictHostKeyChecking=no ${user}@${server} "systemctl restart sailingsa-api && echo Done"
expect {
    -re "assword" { send "$password\r"; exp_continue }
    "Done" { }
    eof { }
    timeout { puts "ERROR: timeout"; exit 1 }
}
wait

puts ""
puts "Done. Lipton 2026 should now show: Sailed: 3, Discards: 0, To count: 3"
puts "Verify: https://sailingsa.co.za/regatta/2026-08-29-lipton-challenge-cup"
