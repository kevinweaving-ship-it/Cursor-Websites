#!/usr/bin/expect -f
# Apply auth-funnel human learn patch on live + restart API + smoke test
set timeout 120
spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/patch_learn_auth_funnel_human.py /workspace/sailingsa/deploy/_remote_test_auth_funnel_human.py root@102.218.215.253:/tmp/
expect {
  -re "(?i)password:" { send "TimAdd#072082\r"; exp_continue }
  eof
}
spawn ssh -o StrictHostKeyChecking=no root@102.218.215.253 bash -lc {python3 /tmp/patch_learn_auth_funnel_human.py; /var/www/sailingsa/api/venv/bin/python -m py_compile /var/www/sailingsa/api/api.py; systemctl restart sailingsa-api; sleep 3; systemctl is-active sailingsa-api; /var/www/sailingsa/api/venv/bin/python /tmp/_remote_test_auth_funnel_human.py}
expect {
  -re "(?i)password:" { send "TimAdd#072082\r"; exp_continue }
  eof
}
