#!/usr/bin/expect -f
set timeout 90
set password "TimAdd#072082"
set server "102.218.215.253"
set user "root"

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/frontend/js/midmar-leaderboard.js ${user}@${server}:/tmp/midmar-leaderboard.js
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn scp -o StrictHostKeyChecking=no /workspace/sailingsa/deploy/apply_midmar_lb_after_races.py ${user}@${server}:/tmp/apply_midmar_lb_after_races.py
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait

spawn ssh -o StrictHostKeyChecking=no ${user}@${server} {TS=$(date +%Y%m%d_%H%M%S); tar -czf /root/backup_midmar_lb_after_races_${TS}.tar.gz /var/www/sailingsa/js/midmar-leaderboard.js /var/www/sailingsa/js/midmar-live-media.js /var/www/sailingsa/api/api.py; echo BACKUP:/root/backup_midmar_lb_after_races_${TS}.tar.gz; chattr -i /var/www/sailingsa/api/api.py; python3 /tmp/apply_midmar_lb_after_races.py; python3 -m py_compile /var/www/sailingsa/api/api.py; echo API_COMPILE:$?; systemctl restart sailingsa-api; sleep 2; systemctl is-active sailingsa-api; chattr +i /var/www/sailingsa/api/api.py; echo DONE}
expect {
    -re "assword" { send "$password\r"; exp_continue }
    eof { }
}
wait
