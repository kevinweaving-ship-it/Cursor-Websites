# Copy values into gitignored .env at repo root. Never commit secrets.
OLARM_API_TOKEN=

# Tuya OpenAPI (Central Europe = openapi.tuyaeu.com). TUYS UI stays paused until
# GET /api/arial/tuya/probe returns ok. If token mint works but /status is 1010,
# extend IoT Core trial on iot.tuya.com then unlink/relink Smart Life.
TUYA_CLIENT_ID=
TUYA_SECRET=
TUYA_REGION=eu
TUYA_DEVICE_ID=bf90676b1341ecb34dse39

# Comma-separated Olarm PGM numbers the keypad may pulse (1s, like an RF remote).
# Empty = no PGM keys. Bing garage motor is PGM 1.
# ARIAL_PGM_ALLOW=1
