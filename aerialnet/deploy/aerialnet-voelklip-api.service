[Unit]
Description=Aerialnet Voelklip / HOME keypad API (Olarm)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/aerialnet-arial
Environment="PYTHONPATH=/opt/aerialnet-arial"
Environment="PATH=/opt/aerialnet-arial/venv/bin"
Environment="ARIAL_DATA_DIR=/var/www/aerialnet/data"
Environment="ARIAL_USERS_DIR=/var/www/aerialnet/data"
Environment="ARIAL_SITE_ID=voelklip"
Environment="ARIAL_SITE_LABEL=HOME"
Environment="ARIAL_AREA_LABEL=Main House"
Environment="ARIAL_OLARM_DEVICE_ID=d6f25654-5fe8-4a85-a7ba-f8ff1449144a"
Environment="ARIAL_TUYA_ENABLED=0"
Environment="ARIAL_EXIT_DELAY=30"
Environment="ARIAL_ENERGY_SAMPLER=0"
Environment="ARIAL_NEXT_DOMAIN=aerialnet.co.za"
Environment="STATIC_DIR=/home/user-data/www/aerialnet.co.za"
Environment="ARIAL_LIVE_STATE=/var/www/aerialnet/data/voelklip_live_state.json"
Environment="ARIAL_ENERGY_LOG=/var/www/aerialnet/data/voelklip_energy_bins.json"
Environment="ARIAL_KEYPAD_LOG=/var/www/aerialnet/data/voelklip_keypad_log.json"
Environment="ARIAL_WHATSAPP_LOG=/var/www/aerialnet/data/whatsapp_log.jsonl"
EnvironmentFile=-/etc/aerialnet-olarm.env
EnvironmentFile=-/etc/aerialnet-tuya.env
ExecStart=/opt/aerialnet-arial/venv/bin/uvicorn arial_app:app --host 127.0.0.1 --port 8004 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
